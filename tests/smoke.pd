#N canvas 60 60 820 460 12;
#X obj 30 20 loadbang;
#X obj 30 60 delay 100;
#X obj 130 60 delay 200;
#X obj 230 60 delay 300;
#X obj 350 60 delay 500;
#X obj 450 60 delay 900;
#X obj 550 60 delay 2500;
#X msg 30 110 open sine_mono_44100_s16.wav;
#X obj 30 150 af.info;
#X obj 30 190 print INFO;
#X msg 130 110 \; pd dsp 1;
#X msg 230 110 open sine_mono_44100_s16.wav \, play 1;
#X msg 350 110 play 1;
#X msg 450 110 getpos;
#X msg 550 110 \; pd quit;
#X obj 230 250 af.play~ 1;
#X obj 230 320 print PLAY;
#X text 30 360 Loaded headless by tests/run_pd_smoke.py. The help files
are the demonstration patches.;
#X text 30 400 The open and play are sent as one message with no gap
between them: that is where a stream reports a dropout it has not had.;
#X obj 650 60 delay 1300;
#X msg 650 110 open no_such_file.wav;
#X obj 650 150 af.info;
#X obj 650 190 print MISSING;
#X text 650 230 A failure has to reach the console as well as the outlet.;
