#N canvas 60 60 640 600 12;
#X text 20 14 [af.info] - what is in a sound file;
#X text 20 40 Reads a file's header and reports its sample rate \, frame
count \, channel count and sample format. It reads no audio.;
#X obj 30 128 bng 19 250 50 0 empty empty empty 17 7 0 10 #fcfcfc #000000
#000000;
#X text 58 129 pick a file;
#X obj 30 164 openpanel;
#X msg 270 164 read no-such-file.wav;
#X text 270 132 or send a name yourself:;
#X obj 30 240 af.info;
#X obj 30 280 route error;
#X obj 120 322 unpack f f f s;
#X floatatom 120 362 8 0 0 0 - - - 0;
#X floatatom 210 362 10 0 0 0 - - - 0;
#X floatatom 320 362 5 0 0 0 - - - 0;
#X symbolatom 380 362 8 0 0 0 - - - 0;
#X text 120 386 rate;
#X text 210 386 frames;
#X text 320 386 chans;
#X text 380 386 format;
#X obj 30 322 print error;
#X text 20 424 A bare symbol reads the file too \, so [openpanel] connects
straight in.;
#X text 20 478 A path is looked up the way Pd looks up any file: next
to the patch first \, then along the search path. Absolute paths work.;
#X text 20 532 A file it cannot open replies error with a short reason:
nofile \, format or badargs.;
